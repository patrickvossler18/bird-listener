# bird-listener per-node configuration.
#
# Lives at /etc/bird-listener/node.env on each Pi. `birdlistener flash` writes
# it for you (via cloud-init); for a hand-built Pi, copy this file there, fill
# it in, and run `sudo bash install.sh`. Every script on the node reads it,
# so it is the ONE place a deployment differs from the repo.

# Which half of the system this Pi is: "window" (mic + BirdNET-Go + MQTT
# broker) or "wall" (e-ink display).
BL_NODE=window

# --- shared -----------------------------------------------------------------
# MQTT credentials. The window node creates this user in Mosquitto; the wall
# node uses it to subscribe. Same value on both Pis.
BL_MQTT_USER=birds
BL_MQTT_PASS=change-me

# --- window node ------------------------------------------------------------
# Rough coordinates: BirdNET-Go's range model uses them to weight detections
# toward species plausible nearby. City-level precision is plenty.
BL_LATITUDE=0.0
BL_LONGITUDE=0.0
# Minimum BirdNET-Go confidence for a detection to count (0..1).
BL_THRESHOLD=0.7

# --- wall node --------------------------------------------------------------
# Hostname (or IP) of the window node, where the broker runs.
BL_MQTT_HOST=birdpi.local
# The PhotoPainter mounts its panel upside down relative to the driver: 180.
BL_ROTATE=180
# IANA zone for the caption clock. Leave blank to use the Pi's own timezone.
BL_TIMEZONE=

# --- install ----------------------------------------------------------------
# Where install.sh clones the code from on first boot.
BL_REPO_URL=https://github.com/patrickvossler18/bird-listener.git
BL_REPO_REF=main
