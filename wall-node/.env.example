# wall-node runtime settings, read by bird-display.service (EnvironmentFile).
# wall-node/setup.sh writes this file from /etc/bird-listener/node.env on first
# install and never overwrites it afterwards, so hand edits stick. Restart to
# apply:  sudo systemctl restart bird-display
# Full list of knobs and their meaning: wall-node/config.py

# Where the broker lives (the window node) and the credentials it expects.
BL_MQTT_HOST=birdpi.local
BL_MQTT_USER=birds
BL_MQTT_PASS=change-me

# Panel orientation inside the PhotoPainter frame (0 or 180).
BL_ROTATE=180

# Caption clock zone. Blank = the Pi's own timezone.
BL_TIMEZONE=

# Detection grouping and refresh pacing.
BL_MIN_CONFIDENCE=0.65
BL_MAX_BIRDS=4
BL_MULTI_WINDOW_SECONDS=900
BL_MIN_REFRESH_SECONDS=30

# Render tuning that reads well on the 7.3" Spectra-6 panel.
BL_SHARPEN=0.8
BL_CAPTION_SCALE=1.5

# Optional BH1750 light sensor: 1 to blank the panel when the room is dark.
BL_LIGHT_GATE=0
