# Reference copy of the unit wall-node/setup.sh installs (it substitutes the
# user, paths and e-Paper library location). All tunables live in
# wall-node/.env; see .env.example.
[Unit]
Description=Bird Listener wall-node e-ink display service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/bird-listener/wall-node
EnvironmentFile=/home/pi/bird-listener/wall-node/.env
# Unbuffer Python stdout so [detect]/[render] logs reach the journal live
# (otherwise low-volume prints sit in the block buffer and never appear).
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/e-Paper/RaspberryPi_JetsonNano/python/lib
ExecStart=/home/pi/bird-listener/wall-node/.venv/bin/python display_service.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
